# Mock mode: the whole interface runs on local fixtures, no API needed.
# Off by default - the app talks to the real API through the dev proxy.
VITE_MOCK=false

# Google Maps browser key. Leave empty to use the built in schematic map.
VITE_GOOGLE_MAPS_KEY=

# A vector Map ID (Google console: Map Management, JavaScript, Vector, Rotation enabled).
# Needed for the navigation map to rotate heading-up; empty keeps it north-up.
VITE_GOOGLE_MAPS_ID=

# Google Identity client id, for the Google sign in button. Empty disables it.
VITE_GOOGLE_CLIENT_ID=

# Override the API origin. Empty means same origin, proxied to localhost:3001 in dev.
VITE_API_BASE=
